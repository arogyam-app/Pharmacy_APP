# Copy to .env and adjust. .env is git-ignored.

ENVIRONMENT=development
DEBUG=true

# SQLite for dev; swap for postgresql+psycopg://user:pass@host:5432/pharmacy later
DATABASE_URL=sqlite:///./pharmacy.db

# CHANGE THIS before any real deployment
SECRET_KEY=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- session cookie ---------------------------------------------------------
# The refresh token rides in an httpOnly cookie so no script can read it.
# Nothing here ever holds a password.
COOKIE_NAME=pharmacy_session
# MUST be true wherever the app is served over HTTPS. Left false for the
# plain-http dev setup: a Secure cookie is dropped on an http origin, and the
# symptom is a login that never sticks.
COOKIE_SECURE=false
# `lax` blocks the cookie on cross-site POSTs, which is what keeps CSRF off
# /auth/refresh. It also means the SPA and API must be on the same site — use
# 127.0.0.1 for both, or localhost for both, never one of each.
COOKIE_SAMESITE=lax
# Leave blank for a host-only cookie; set (e.g. .pharmacy.example) only when the
# SPA and API are on different sub-domains of one site.
# COOKIE_DOMAIN=
# How long "Keep me signed in" lasts. Without it the cookie dies with the browser.
REMEMBER_ME_DAYS=30

# Seed data (app/db/seed.py)
SEED_STORE_NAME=My Pharmacy
SEED_STORE_STATE_CODE=18
# Reserved TLDs (.local, .test, .example, .invalid) fail email validation.
SEED_ADMIN_EMAIL=admin@pharmacy.in
SEED_ADMIN_PASSWORD=Admin@123

# --- serving the app --------------------------------------------------------
# Off in development: Vite serves the SPA with hot reload and proxies the API.
# On in the native Windows deployment, where one uvicorn serves both on one
# port -- same origin, so no CORS and the session cookie works. ops\serve.ps1
# sets this itself, so it normally stays false here.
SERVE_SPA=false
# Where `npm run build` puts its output. Relative to the backend directory.
SPA_DIST_DIR=../frontend/dist

# --- invoice numbering ------------------------------------------------------
# Where the customer-facing invoice series opens. Must be 8 digits: numbers are
# zero-padded to 8 and the column is CHAR(8).
#
# ONLY READ WHEN THE SEQUENCE ROW IS FIRST CREATED, by the one-time seed.
# Changing it later does nothing -- a gap-free counter carries on from where it
# is. Returns, credit notes and purchases always start at 1.
INVOICE_NUMBER_START=10000001

# --- Supabase replication ---------------------------------------------------
# Leave blank to disable; ops\backup.ps1 then only writes local dumps.
# Use the DIRECT connection (db.<ref>.supabase.co:5432), NOT the pooler on
# 6543 -- pg_restore needs session features the transaction pooler lacks.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require
